# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Python
__pycache__
*.pyc
*.pyo
.venv
venv
.env

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Results (keep only reports and summaries)
results/**/gen_log.jsonl
results/**/*.tmp
results/stress_chamber/
!/results/**/*.md
!/results/**/*.json

# --- TRADE SECRET EXCLUSIONS ---
# Exclude Game/Dashboard Components
components/
backend/
# Exclude specific Game Services (Keep Middleware Services!)
services/ai.ts
services/codeGenerator.ts
services/websocket.ts
# Exclude React Game App Entrypoints
App.tsx
index.tsx
index.html

# Results (ignore all artifacts)
results/**
!results/
!results/.gitkeep
!results/**/.gitkeep
!results/**/*.template

# OperatorPack Artifacts
# Ignore all benchmark receipts and verdicts
receipts/**/*.json
receipts/**/*.json.verdict.json
receipts/summary/*

# Keep structural files and examples
!receipts/**/.gitkeep
!receipts/examples/**

# Ignore generated indexes and summaries (local only)
receipts/RECEIPTS_INDEX.md
receipts/RECEIPTS_INDEX_EXPERIMENTAL.md
receipts/summary/RECEIPTS_SUMMARY.md
receipts/summary/*.md
!receipts/RECEIPTS_INDEX.md.template
!receipts/RECEIPTS_INDEX_EXPERIMENTAL.md.template

# Safe templates (if any exist with .template suffix)
!receipts/**/*.template
